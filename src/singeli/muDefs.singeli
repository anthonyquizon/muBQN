# Replacement for CBQN's src/singeli/src/cbqnDefs.singeli, with the same names,
# so vendored kernels build against muBQN. Vendor cbqnDefs.singeli as a single
# line: include '../muDefs'
# Derived from CBQN (dzaima and contributors), used under MPL2.
# Every emitted C name is defined in si_prelude.h.

# ---- boxed values (cmp.singeli only). x is a muBQN B passed as u64.
def bcall{T, f, x} = emit{T, f, x}
def from_B{T, x if T==f64} = bcall{T, 'si_o2f', x}
def from_B{T, x if T<=i32 and   issigned{T}} = bcall{T, 'si_o2i', x}
def from_B{T, x if T<=u32 and isunsigned{T}} = bcall{T, 'si_o2c', x}
def fatal{msg} = emit{void, 'si_fatal', merge{'"', msg, '"'}}

def q_f64{x} = bcall{u1, 'si_q_f64', x}
def q_chr{x} = bcall{u1, 'si_q_c32', x}
def q_chr{(u8 ),x} = bcall{u1, 'si_q_c8',  x}
def q_chr{(u16),x} = bcall{u1, 'si_q_c16', x}
def q_chr{(u32),x} = bcall{u1, 'si_q_c32', x}
def q_fint{T, x:(f64) if isint{T}} = {
  buf:= undefined{T, 1};
  def ok = emit{u1, merge{'q_f', fmt_type{T}, 'o'}, buf, x}
  tup{load{buf}, ok}
}

# ---- tags. Only the char tag is read by kernels (copy, squeeze), as the top
# 16 bits of a B. The other CBQN tags are left undefined on purpose: a kernel
# that needs one fails to compile instead of silently using wrong bits.
def cbqn_c32Tag{} = emit{u64, '', 'SI_C32_TAG'}

# CBQN element-type numbering, kept as is: it indexes the export tables.
def cbqn_elType = match {
  {(u1)} => 0; {(i8)} => 1; {(i16)} => 2; {(i32)} => 3; {(f64)} => 4
               {(u8)} => 5; {(u16)} => 6; {(u32)} => 7
}

# Bytes from an array object to its data (copy_ubit only). muBQN puts the
# shape between header and data, so this assumes rank 1. Revisit with bit
# arrays (milestone 2).
def cbqn_tyArrOffset{} = emit{u64, '', 'SI_DATA_OFFSET'}

# ---- scratch memory (bins, hashtab)
def talloc{T, len} = emit{*T, 'SI_TALLOC', fmt_type{T}, len}
def tfree{ptr} = emit{void, 'SI_TFREE', ptr}
def fmt_type{T} = merge{quality{T}, fmtnat{width{T}}}
def fmt_type{*T} = merge{'*',fmt_type{T}}

def el_bit = 0
def el_i8  = 1
def el_i16 = 2
def el_i32 = 3
def el_f64 = 4
def el_c8  = 5
def el_c16 = 6
def el_c32 = 7
def el_B   = 8

# ---- min/max of an integer-valued buffer (select). Table filled in C from
# search.singeli's simd_getRangeRaw.
def get_range{elt, data:*_, len:ux if any_int{elt} and (not knum{elt} or (elt>=el_bit and elt<=el_f64))} = {
  def fns = emit{*fntype{*void, *i64, u64, u1}, '', 'si_getRange_fns'}
  buf:*i64 = undefined{i64, 2}
  def ok = load{fns, elt}(*void~~data, buf, len)
  tup{ok, load{buf,0}, load{buf,1}}
}

def get_range{data:*E, len} = get_range{match(E) {
  {(u1)} => el_bit
  {(i8)} => el_i8
  {(i16)} => el_i16
  {(i32)} => el_i32
  {(f64)} => el_f64
}, data, len}
def get_range{data:*E, s, e} = get_range{data+s, e-s}

# ---- total comparisons: unchanged from cbqnDefs, no CBQN dependency
local def root{G, T} = G{T}
local def root{G, [_]E} = G{E}

def tot_gt{a:T, b:T if root{isfloat,T}} = (b==b) &~ (a<=b)
def tot_ge{a:T, b:T if root{isfloat,T}} = (a!=a) |  (a>=b)

def tot_gt{a:V=[_]E, b:V if isfloat{E} and hasarch{'X86_64'} and width{V}<=256} =   ord{V~~(a<=b), b}
def tot_ge{a:V=[_]E, b:V if isfloat{E} and hasarch{'X86_64'} and width{V}<=256} = unord{V~~(a>=b), a}

def tot_gt{a:T, b:T if root{isint,T}} = a > b
def tot_ge{a:T, b:T if root{isint,T}} = a >= b

def tot_lt{a, b} = tot_gt{b, a}
def tot_le{a, b} = tot_ge{b, a}
